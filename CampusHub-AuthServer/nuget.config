<?xml version="1.0" encoding="utf-8"?>
<!--
  Pinned to nuget.org ONLY.

  <clear /> is load-bearing: a machine-level NuGet.Config that includes the Telerik feed
  breaks `dotnet restore` for this project with an authentication prompt it cannot answer.
  Clearing inherited sources first makes the restore reproducible on any machine.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
