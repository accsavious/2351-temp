@page "/checkout"
@using Fluxor
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<CartState> CartState
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation

<h3>Checkout</h3>

<table class="table">
    <thead>
        <tr>
            <th>Item</th>
            <th>Price</th>
            <th>Qty</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in CartState.Value.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Quantity</td>
                <td>
                    <button class="btn btn-sm btn-danger"
                            @onclick="() => Remove(item.Name)">
                        Remove
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<p><strong>Total:</strong> @CartState.Value.Items.Sum(i => i.Price * i.Quantity).ToString("C")</p>

<button class="btn btn-outline-danger" @onclick="ClearCart">Clear Cart</button>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (CartState.Value.Items.Count == 0)
        {
            Navigation.NavigateTo("/shop");
            return;
        }
    }

    private void Remove(string itemName)
    {
        Dispatcher.Dispatch(new RemoveFromCartAction(itemName));
    }

    private void ClearCart()
    {
        Dispatcher.Dispatch(new ClearCartAction());
        Navigation.NavigateTo("/shop");
    }
}
