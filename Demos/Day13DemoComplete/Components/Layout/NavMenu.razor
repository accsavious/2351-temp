    <hr class="mx-3 my-2" />

    <div class="nav-item px-3 py-2">
        @* AuthorizeView renders the <Authorized> or <NotAuthorized> branch based on
           the cascaded auth state -- no manual if/else against the user. `context`
           is the AuthenticationState, so context.User.Identity?.Name is the logged-in
           name (populated because NameClaimType = "name" in Program.cs; on this
           provider the name claim holds the email address).
           The Login/Logout links point at the /Account/* minimal-API endpoints, NOT
           Blazor routes -- those endpoints call ChallengeAsync / SignOutAsync (see Program.cs). *@
        <AuthorizeView>
            <Authorized>
                <span class="nav-link text-light">Hello, @context.User.Identity?.Name</span>
                <a class="nav-link" href="/Account/Logout">Logout</a>
            </Authorized>
            <NotAuthorized>
                <a class="nav-link" href="/Account/Login">Login</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>
