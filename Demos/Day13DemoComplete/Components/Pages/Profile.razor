@page "/profile"
@using System.Security.Claims

<PageTitle>My Profile</PageTitle>

<h1>My Profile</h1>

@if (isAuthenticated)
{
    <p>Welcome, <strong>@userName</strong>!</p>

    <h2>Your Claims</h2>
    <table class="table table-striped">
        <thead>
            <tr><th>Type</th><th>Value</th><th>Issuer</th></tr>
        </thead>
        <tbody>
            @foreach (var claim in claims)
            {
                <tr>
                    <td><code>@claim.Type</code></td>
                    <td>@claim.Value</td>
                    <td>@claim.Issuer</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">
        Please <a href="/Account/Login?returnUrl=/profile">log in</a> to view your profile.
    </div>
}

@code {
    // The cascaded auth state arrives as a Task<AuthenticationState>, NOT a plain
    // AuthenticationState, because resolving the user can be asynchronous. You await
    // it once (below) to get the current snapshot -- supplied by the
    // CascadingAuthenticationState wrapper in Routes.razor.
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool isAuthenticated;
    private string userName = "";
    private IEnumerable<Claim> claims = [];

    protected override async Task OnInitializedAsync()
    {
        // Await the Task to unwrap the user. user.Claims is what the OIDC handler kept
        // from the ID token: sub, name, email, plus two OpenIddict ids (oi_au_id,
        // oi_tkn_id). The handler drops protocol claims such as iss, aud, exp, nonce.
        var authState = await AuthState;
        var user = authState.User;

        isAuthenticated = user.Identity?.IsAuthenticated ?? false;

        if (isAuthenticated)
        {
            userName = user.Identity?.Name ?? "Unknown";
            claims = user.Claims;
        }
    }
}
